{
  "labelRenames": [
    {
      "matchRegex": "(?i)system",
      "renameLabel": "System"
    },
    {
      "matchRegex": "(?i)prozessor",
      "renameLabel": "CPU"
    },
    {
      "matchRegex": "(?i)fon-anschluss",
      "renameLabel": "Phone"
    },
    {
      "matchRegex": "(?i)^wlan",
      "renameLabel": "WLAN"
    },
    {
      "matchRegex": "(?i)^usb",
      "renameLabel": "USB"
    },
    {
      "matchRegex": "(?i)^internal_storage",
      "renameLabel": "Internal"
    },
    {
      "matchRegex": "(?i)^usb_storage",
      "renameLabel": "USB"
    }
  ],
  "metrics": [
    {
      "path": "data.lua",
      "params": "page=shareVpn",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "connected",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_ipsec_status",
        "help": "status of IPSec VPN connections (1 = connected)",
        "varLabels": [
          "gateway",
          "name",
          "localNet",
          "remoteNet",
          "remoteIP"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=shareWireguard",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "connected",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_wireguard_status",
        "help": "status of Wireguard VPN connections (1 = connected)",
        "varLabels": [
          "gateway",
          "name",
          "localNet",
          "remoteNet",
          "remoteIp"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=ecoStat",
      "resultPath": "data.cputemp.series.0",
      "resultKey": "-1",
      "promDesc": {
        "fqName": "gateway_system_cpu_temperature_celsius",
        "help": "system CPU temperature (deg Celsius)",
        "varLabels": [
          "gateway"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=ecoStat",
      "resultPath": "data.cpuutil.series.0",
      "resultKey": "-1",
      "promDesc": {
        "fqName": "gateway_system_cpu_utilization_percent",
        "help": "system CPU utilization (percent)",
        "varLabels": [
          "gateway"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=ecoStat",
      "resultPath": "data.ramusage.series.0",
      "resultKey": "-1",
      "promDesc": {
        "fqName": "gateway_system_ram_utilization_percent",
        "help": "system RAM utilization (percent)",
        "varLabels": [
          "gateway"
        ],
        "fixedLabels": {
          "ram_type": "Fixed"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=ecoStat",
      "resultPath": "data.ramusage.series.1",
      "resultKey": "-1",
      "promDesc": {
        "fqName": "gateway_system_ram_utilization_percent",
        "help": "system RAM utilization (percent)",
        "varLabels": [
          "gateway"
        ],
        "fixedLabels": {
          "ram_type": "Dynamic"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=ecoStat",
      "resultPath": "data.ramusage.series.2",
      "resultKey": "-1",
      "promDesc": {
        "fqName": "gateway_system_ram_utilization_percent",
        "help": "system RAM utilization (percent)",
        "varLabels": [
          "gateway"
        ],
        "fixedLabels": {
          "ram_type": "Free"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=energy",
      "resultPath": "data.drain.*",
      "resultKey": "actPerc",
      "promDesc": {
        "fqName": "gateway_system_energy_consumption_percent",
        "help": "system energy consumption (percent)",
        "varLabels": [
          "gateway",
          "name"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300
    },
    {
      "path": "data.lua",
      "params": "page=energy",
      "resultPath": "data.drain.*.lan.*",
      "resultKey": "class",
      "okValue": "green",
      "promDesc": {
        "fqName": "gateway_lan_status",
        "help": "status of LAN connections (1 = up)",
        "varLabels": [
          "gateway",
          "name"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60
    },
    {
      "path": "data.lua",
      "params": "page=usbOv",
      "resultPath": "data.usbOverview.devices.*",
      "resultKey": "partitions.0.totalStorageInBytes",
      "promDesc": {
        "fqName": "gateway_system_storage_total_bytes",
        "help": "system total storage (bytes)",
        "varLabels": [
          "gateway",
          "deviceType",
          "deviceName"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=usbOv",
      "resultPath": "data.usbOverview.devices.*",
      "resultKey": "partitions.0.usedStorageInBytes",
      "promDesc": {
        "fqName": "gateway_system_storage_used_bytes",
        "help": "system used storage (bytes)",
        "varLabels": [
          "gateway",
          "deviceType",
          "deviceName"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 300,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=shareVpn",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "active",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_connection_enabled",
        "help": "VPN connection enabled (1 = enabled)",
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {
          "protocol": "IPsec"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=shareVpn",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "connected",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_connection_status",
        "help": "VPN connection status (1 = connected)",
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {
          "protocol": "IPsec"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=shareWireguard",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "active",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_connection_enabled",
        "help": "VPN connection enabled (1 = enabled)",
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {
          "protocol": "Wireguard"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "data.lua",
      "params": "page=shareWireguard",
      "resultPath": "data.init.boxConnections.*",
      "resultKey": "connected",
      "okValue": "true",
      "promDesc": {
        "fqName": "gateway_vpn_connection_status",
        "help": "VPN connection status (1 = connected)",
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {
          "protocol": "Wireguard"
        }
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    }
  ]
}
