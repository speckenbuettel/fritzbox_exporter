    {
      "path": "generic/vpn",
      "params": "",
      "resultPath": "connection.*",
      "resultKey": "state",
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "promDesc": {
        "fqName": "gateway_vpn_bridge",
        "help": "gateway vpn bridge",
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {}
      },
      "okValue": "ready",
      "filter": {
        "access_type": "3"
      },
      "allowEmpty": true
    },
    {
      "path": "generic/vpn",
      "params": "",
      "resultPath": "connection.*",
