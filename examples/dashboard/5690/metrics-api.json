{
  "labelRenames": [
    {
      "matchRegex": "^LAN:1$",
      "renameLabel": "LAN 1"
    },
    {
      "matchRegex": "^LAN:2$",
      "renameLabel": "LAN 2"
    },
    {
      "matchRegex": "^LAN:3$",
      "renameLabel": "LAN 3"
    },
    {
      "matchRegex": "^WAN:1$",
      "renameLabel": "WAN"
    },
    {
      "matchRegex": "(?i)^fib(er|re)$",
      "renameLabel": "FIBRE"
    }
  ],
  "metrics": [
    {
      "path": "generic/vpn",
      "params": "",
      "resultPath": "connection.*",
      "resultKey": "state",
      "okValue": "ready",
      "filter": {
        "access_type": "3"
      },
      "labelPaths": {
        "localNet": "display_local_net",
        "remoteNet": "display_remote_net",
        "remoteIP": "remote_ip"
      },
      "promDesc": {
        "fqName": "gateway_vpn_ipsec_status",
        "help": "status of IPSec VPN connections (1 = connected)",
        "varLabels": [
          "gateway",
          "name",
          "localNet",
          "remoteNet",
          "remoteIP"
        ]
      },
      "promType": "GaugeValue",
      "cacheEntryTTL": 60,
      "allowEmpty": true
    },
    {
      "path": "generic/vpn",
      "params": "",
      "resultPath": "connection.*",
