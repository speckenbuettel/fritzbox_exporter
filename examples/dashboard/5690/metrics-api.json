      "resultKey": "state",
      "params": "",
      "okValue": "ready",
      "cacheEntryTTL": 30,
      "path": "generic/vpn",
      "promType": "GaugeValue",
      "resultPath": "connection.*",
      "allowEmpty": true
    },
    {
      "promDesc": {
        "varLabels": [
          "gateway",
          "name"
        ],
        "fixedLabels": {},
